@@ -0,0 +1,212 @@
+/*==============================================================================
+File    ldnx_adc.c
+
+Author  Daniel Zorychta
+
+Brief   Lua bindings to dnx RTOS services: dnx.adc module (analog-digital
+        converter, ADC driver).
