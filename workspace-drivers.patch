diff --git a/sim-env/models/norflash.lua b/sim-env/models/norflash.lua
new file mode 100644
index 0000000..6f00cdc
--- /dev/null
+++ b/sim-env/models/norflash.lua
@@ -0,0 +1,349 @@
+--[[----------------------------------------------------------------------------
+  Serial NOR flash memory model (W25Qxx, MX25Lxx and similar), SPI mode 0 or 3,
+  MSB first. Memory is stored sparsely (only programmed 4 KiB sectors), so big
+  memories can be simulated.
+
+  Usage:
+    local norflash = require("models.norflash")
+    local flash = norflash.new{type = "w25q16"}
+    flash:attach("SPI:0", "PB3")                -- bus, CS pin (active low)
+
+  Options of new():
+    type          memory type (table TYPES), or explicit parameters:
+    id            JEDEC ID (3 bytes, string)
+    size          memory size in bytes (multiple of 4 KiB)
+    sfdp          SFDP table is available (JEDEC basic flash parameters)
+    addr4         4-byte address instructions (0x13, 0x12, 0x21, 0x0C)
+    protected     block protection set at power-up (BP2..BP0 = 111, whole
+                  memory protected, as SST26/AT25 memories)
+    power_down    memory in deep power-down at start (only RDP 0xAB accepted)
+    page_time     page program time in ms (default 0.5)
+    erase_time    sector erase time in ms (default 3)
+
+  Instructions: RDID (0x9F), SFDP (0x5A), READ (0x03, 0x13), FAST READ (0x0B,
+  0x0C), PP (0x02, 0x12, page roll-over), SE 4 KiB (0x20, 0x21), BE 64 KiB
+  (0xD8), CE (0xC7, 0x60), WREN (0x06), WRDI (0x04), RDSR (0x05), WRSR (0x01),
+  global block unlock (0x98, clears BP bits), deep power-down (0xB9), release
+  from deep power-down (0xAB). Programming only clears bits (AND). During
+  program/erase only RDSR is accepted.
+
+  Methods:
+    flash:attach(bus, cs)        connect to bus
+    flash:read(addr, n)          read memory (host side)
+    flash:write(addr, data)      write memory without erase (host side)
+    flash:erase_all()            erase memory (host side)
+    flash:stats()                number of sector erases, page programs
+------------------------------------------------------------------------------]]
+
+local M = {}
+
+local SECTOR = 4096
+local PAGE = 256
+local ERASED = string.rep("\xFF", SECTOR)
+
+M.TYPES = {
+    w25q16 = { id = "\xEF\x40\x15", size = 2 * 1024 * 1024, sfdp = true },
+    w25q256 = { id = "\xEF\x40\x19", size = 32 * 1024 * 1024, sfdp = true, addr4 = true },
+    mx25l8005 = { id = "\xC2\x20\x14", size = 1024 * 1024, sfdp = false },
+    sst26vf016 = { id = "\xBF\x26\x41", size = 2 * 1024 * 1024, sfdp = true, protected = true },
+}
+
+local FLASH = {}
+FLASH.__index = FLASH
+
+-- SFDP table: header, parameter header of JEDEC basic table (9 DWORDs at 0x30)
+local function sfdp_table(size)
+    local t = string.rep("\xFF", 0x30 + 36)
+    local function put(off, s)
+        t = t:sub(1, off) .. s .. t:sub(off + #s + 1)
+    end
+    put(0, "SFDP\x06\x01\x00\xFF")
+    put(8, "\x00\x06\x01\x09\x30\x00\x00\xFF")
+    local bits = size * 8
+    local dw1 = 0xFFF920E5 -- 4 KiB erase (0x20), 3 or 4 address bytes
+    local dw2
+    if bits > 0x80000000 then
+        dw2 = 0x80000000 | (math.floor(math.log(bits, 2) + 0.5))
+    else
+        dw2 = bits - 1
+    end
+    put(0x30, string.pack("<I4I4", dw1, dw2))
+    return t
+end
+
+function M.new(opts)
+    opts = opts or {}
+    local t = opts.type and M.TYPES[string.lower(opts.type)]
+    if opts.type and not t then
+        error("norflash: unknown type: " .. tostring(opts.type), 2)
+    end
+    t = t or {}
+
+    local f = setmetatable({}, FLASH)
+    f.id = opts.id or t.id
+    f.size = opts.size or t.size
+    f.addr4 = opts.addr4 or t.addr4 or false
+    local sfdp = opts.sfdp
+    if sfdp == nil then
+        sfdp = t.sfdp
+    end
+    f.sfdp = sfdp and sfdp_table(f.size) or nil
+    f.page_time = opts.page_time or 0.5
+    f.erase_time = opts.erase_time or 3
+    f.mode = { [0] = true, [3] = true }
+
+    assert(type(f.id) == "string" and #f.id == 3, "norflash: invalid JEDEC ID")
+    assert(math.type(f.size) == "integer" and f.size % SECTOR == 0, "norflash: invalid size")
+
+    f.mem = {}
+    f.busy_until = 0
+    f.wel = false
+    local protected = opts.protected
+    if protected == nil then
+        protected = t.protected
+    end
+    f.bp = protected and 0x1C or 0
+    f.deep = opts.power_down or false
+    f.erases, f.programs = 0, 0
+    f.state = "idle"
+    return f
+end
+
+function FLASH:read(addr, n)
+    local res = {}
+    while n > 0 do
+        local s = addr // SECTOR
+        local off = addr % SECTOR
+        local m = math.min(n, SECTOR - off)
+        res[#res + 1] = (self.mem[s] or ERASED):sub(off + 1, off + m)
+        addr = (addr + m) % self.size
+        n = n - m
+    end
+    return table.concat(res)
+end
+
+-- program data (AND with memory content), data in one sector
+function FLASH:program(addr, data)
+    local s = addr // SECTOR
+    local off = addr % SECTOR
+    local old = self.mem[s] or ERASED
+    local b = { old:byte(off + 1, off + #data) }
+    for i = 1, #data do
+        b[i] = b[i] & data:byte(i)
+    end
+    self.mem[s] = old:sub(1, off) .. string.char(table.unpack(b)) .. old:sub(off + #data + 1)
+end
+
+function FLASH:write(addr, data)
+    local i = 1
+    while i <= #data do
+        local m = math.min(#data - i + 1, SECTOR - addr % SECTOR)
+        self:program(addr, data:sub(i, i + m - 1))
+        addr = addr + m
+        i = i + m
+    end
+end
+
+function FLASH:erase_all()
+    self.mem = {}
+end
+
+function FLASH:stats()
+    return self.erases, self.programs
+end
+
+function FLASH:busy()
+    return host.time_ms() < self.busy_until
+end
+
+function FLASH:status()
+    return self.bp | (self.wel and 2 or 0) | (self:busy() and 1 or 0)
+end
+
+-- SPI interface
+local ADDR_CMDS = {
+    [0x03] = 3, [0x13] = 4, [0x0B] = 3, [0x0C] = 4, [0x02] = 3, [0x12] = 4,
+    [0x20] = 3, [0x21] = 4, [0xD8] = 3, [0x5A] = 3,
+}
+local DUMMY_CMDS = { [0x0B] = 1, [0x0C] = 1, [0x5A] = 1 }
+
+function FLASH:select()
+    self.state = "cmd"
+    self.cmd = nil
+end
+
+function FLASH:transfer(byte)
+    local state = self.state
+
+    if state == "cmd" then
+        self.cmd = byte
+        local nbytes = ADDR_CMDS[byte]
+        if self.deep and byte ~= 0xAB then
+            self.state = "ignore"
+        elseif self:busy() and byte ~= 0x05 then
+            self.state = "ignore"
+        elseif byte == 0x05 then
+            self.state = "rdsr"
+        elseif byte == 0x9F then
+            self.state, self.ptr = "rdid", 0
+        elseif nbytes and (nbytes == 3 or self.addr4) and (byte ~= 0x5A or self.sfdp) then
+            self.state = "addr"
+            self.addr, self.addr_cnt, self.addr_len = 0, 0, nbytes
+            self.dummy = DUMMY_CMDS[byte] or 0
+        elseif byte == 0x01 then
+            self.state = "wrsr"
+        else
+            self.state = "ignore" -- executed at CS rise or unknown
+        end
+        return 0xFF
+    elseif state == "rdsr" then
+        return self:status()
+    elseif state == "rdid" then
+        self.ptr = self.ptr + 1
+        return self.id:byte(self.ptr) or 0x00
+    elseif state == "addr" then
+        if self.addr_cnt < self.addr_len then
+            self.addr = (self.addr << 8) | byte
+            self.addr_cnt = self.addr_cnt + 1
+        else
+            self.dummy = self.dummy - 1
+        end
+        if self.addr_cnt == self.addr_len and self.dummy == 0 then
+            local cmd = self.cmd
+            if cmd == 0x5A then
+                self.state, self.ptr = "sfdp", self.addr
+            elseif cmd == 0x02 or cmd == 0x12 then
+                self.state = "pp"
+                self.ptr = self.addr % self.size
+                self.data = {}
+            elseif cmd == 0x20 or cmd == 0x21 or cmd == 0xD8 then
+                self.state = "erase"
+            else
+                self.state = "read"
+                self.ptr = self.addr % self.size
+            end
+        end
+        return 0xFF
+    elseif state == "read" then
+        local v = self:read(self.ptr, 1):byte()
+        self.ptr = (self.ptr + 1) % self.size
+        return v
+    elseif state == "sfdp" then
+        self.ptr = self.ptr + 1
+        return self.sfdp:byte(self.ptr) or 0xFF
+    elseif state == "pp" then
+        self.data[#self.data + 1] = string.char(byte)
+        return 0xFF
+    elseif state == "wrsr" then
+        self.new_sr = byte
+        self.state = "ignore"
+        return 0xFF
+    end
+
+    return 0xFF
+end
+
+-- whole SPI transfer (board engine): data of READ and PP in bulk
+function FLASH:transfer_block(data)
+    local n, i, res = #data, 1, {}
+    while i <= n do
+        local state = self.state
+        if state == "read" then
+            res[#res + 1] = self:read(self.ptr, n - i + 1)
+            self.ptr = (self.ptr + n - i + 1) % self.size
+            break
+        elseif state == "pp" then
+            self.data[#self.data + 1] = data:sub(i)
+            res[#res + 1] = string.rep("\xFF", n - i + 1)
+            break
+        end
+        res[#res + 1] = string.char((self:transfer(data:byte(i)) or 0xFF) & 0xFF)
+        i = i + 1
+    end
+    return table.concat(res)
+end
+
+function FLASH:protected(addr)
+    return self.bp & 0x1C ~= 0 -- whole memory protected by any BP bit
+end
+
+function FLASH:deselect()
+    local cmd, state = self.cmd, self.state
+    self.cmd = nil
+    self.state = "idle"
+
+    if state == "idle" or self:busy() then
+        return
+    end
+
+    if self.deep then
+        if cmd == 0xAB then
+            self.deep = false
+        end
+        return
+    end
+
+    local now = host.time_ms()
+    if cmd == 0x06 then
+        self.wel = true
+    elseif cmd == 0x04 then
+        self.wel = false
+    elseif cmd == 0xB9 then
+        self.deep = true
+    elseif cmd == 0x98 and self.wel then
+        self.bp = 0
+        self.wel = false
+    elseif (cmd == 0x02 or cmd == 0x12) and state == "pp" and self.wel then
+        local d = table.concat(self.data)
+        if #d > PAGE then
+            d = d:sub(-PAGE) -- only last 256 bytes are programmed
+        end
+        if not self:protected(self.ptr) and #d > 0 then
+            local base = self.ptr - self.ptr % PAGE
+            local off = self.ptr % PAGE
+            local page = self:read(base, PAGE)
+            local first = d:sub(1, PAGE - off)
+            local wrap = d:sub(PAGE - off + 1)
+            local buf = page:sub(1, off) .. first .. page:sub(off + #first + 1)
+            if #wrap > 0 then
+                buf = wrap .. buf:sub(#wrap + 1)
+            end
+            -- buf: new bytes merged, program only changed area (AND)
+            self:program(base, buf)
+            self.programs = self.programs + 1
+        end
+        self.busy_until = now + self.page_time
+        self.wel = false
+    elseif (cmd == 0x20 or cmd == 0x21 or cmd == 0xD8) and state == "erase" and self.wel then
+        local size = (cmd == 0xD8) and 65536 or SECTOR
+        local base = (self.addr % self.size) - (self.addr % self.size) % size
+        if not self:protected(base) then
+            for s = base // SECTOR, (base + size) // SECTOR - 1 do
+                self.mem[s] = nil
+            end
+            self.erases = self.erases + 1
+        end
+        self.busy_until = now + self.erase_time * size / SECTOR
+        self.wel = false
+    elseif (cmd == 0xC7 or cmd == 0x60) and self.wel then
+        if not self:protected(0) then
+            self.mem = {}
+        end
+        self.busy_until = now + self.erase_time * 10
+        self.wel = false
+    elseif cmd == 0x01 and self.new_sr and self.wel then
+        self.bp = self.new_sr & 0x9C
+        self.busy_until = now + 1
+        self.wel = false
+    end
+
+    self.new_sr = nil
+    self.data = nil
+end
+
+function FLASH:attach(bus, cs)
+    spi.attach(bus, cs, self)
+    return self
+end
+
+return M
diff --git a/sim-env/models/onewire_uart.lua b/sim-env/models/onewire_uart.lua
new file mode 100644
index 0000000..2f22574
--- /dev/null
+++ b/sim-env/models/onewire_uart.lua
@@ -0,0 +1,79 @@
+--[[----------------------------------------------------------------------------
+  1-Wire master on UART (UART TX/RX connected to the 1-Wire line by open
+  drain buffer, as DS9097 adapters or UART in single wire mode). Every
+  character sent by the system is received back with the state of the line:
+    baud rate below 38400: reset pulse, character with presence pulse is
+    changed (0xF0 -> 0xE0), line shorted: 0x00
+    other baud rates: time slot, bit 0 of character is the written bit
+    (0xFF: write 1 / read slot, 0x00: write 0 slot), slot read as 0 changes
+    the character (0xFF -> 0xF8)
+  Characters of other format than 8N1 are not echoed (line is not driven).
+
+  Usage:
+    local onewire_uart = require("models.onewire_uart")
+    local ds18b20 = require("models.ds18b20")
+    local ow = onewire_uart.new{spu = "PB8"}:attach("UART:6")
+    ds18b20.new{serial = 0x1234}:attach(ow)
+
+  Options of new():
+    spu         GPIO pin of strong pull-up (high: on), power of parasite
+                devices (optional)
+
+  Fields: ow (1-Wire bus, models/onewire.lua).
+------------------------------------------------------------------------------]]
+
+local onewire = require("models.onewire")
+
+local M = {}
+
+local MASTER = {}
+MASTER.__index = MASTER
+
+local RESET_BAUD_MAX = 38400
+
+function M.new(opts)
+    opts = opts or {}
+    local m = setmetatable({}, MASTER)
+    m.ow = onewire.new({ name = opts.name })
+    if opts.spu then
+        gpio.on_change(opts.spu, function(level)
+            m.ow:power(level)
+        end)
+    end
+    return m
+end
+
+function MASTER:receive(data)
+    local cfg = uart.config(self.port)
+    if cfg.parity ~= "none" or cfg.stop_bits ~= 1 then
+        return
+    end
+
+    local res = {}
+    for i = 1, #data do
+        local c = data:byte(i)
+        if cfg.baud < RESET_BAUD_MAX then
+            local presence, short = self.ow:reset(false)
+            if short then
+                c = 0x00
+            elseif presence then
+                c = c & 0xE0
+            end
+        else
+            local level = self.ow:slot(c & 1)
+            if level == 0 then
+                c = c & 0xF8
+            end
+        end
+        res[i] = string.char(c)
+    end
+    uart.send(self.port, table.concat(res))
+end
+
+function MASTER:attach(port)
+    self.port = port
+    uart.attach(port, self)
+    return self
+end
+
+return M
diff --git a/sim-env/models/w5500.lua b/sim-env/models/w5500.lua
new file mode 100644
index 0000000..6aee700
--- /dev/null
+++ b/sim-env/models/w5500.lua
@@ -0,0 +1,292 @@
+--[[----------------------------------------------------------------------------
+  W5500 Ethernet controller model (WIZnet), SPI mode 0 or 3, variable data
+  length mode. Only the MACRAW mode of socket 0 is modeled (hardware TCP/IP
+  stack is not): the chip is connected to the Ethernet of the simulator
+  (eth.attach()) as other device models, frames sent by SEND command go to
+  the network, frames received from the network are stored in the RX memory
+  of socket 0 (2-byte length header, MAC filter MFEN: own MAC address,
+  broadcast, multicast if MMB = 0).
+
+  Usage:
+    local w5500 = require("models.w5500")
+    local chip = w5500.new{reset = "PB10"}:attach("SPI:0", "PB9")
+    chip:set_link(false)                       -- cable disconnected
+
+  Options of new():
+    reset       GPIO pin connected to RSTn (low: chip in reset), optional
+    link        link state at start (default true, 100 Mbps full duplex)
+    segment     Ethernet segment (default "lan", see eth.attach())
+
+  Registers: common (MR with software reset, SHAR, PHYCFGR with link state,
+  speed and duplex of configured mode, VERSIONR = 0x04), socket registers
+  (all 8 sockets are stored, buffer sizes Sn_RXBUF_SIZE/Sn_TXBUF_SIZE),
+  socket 0 commands OPEN, CLOSE, SEND (SEND_OK in Sn_IR), RECV, Sn_TX_FSR,
+  Sn_RX_RSR, pointers (RX/TX memory address wraps in the socket buffer).
+
+  Methods:
+    chip:attach(bus, cs)        connect to SPI bus and Ethernet
+    chip:set_link(on)           link state
+    chip:stats()                frames sent, received, dropped (RX memory
+                                full or MAC filter)
+------------------------------------------------------------------------------]]
+
+local M = {}
+
+local CHIP = {}
+CHIP.__index = CHIP
+
+local MEM = 16384
+
+function M.new(opts)
+    opts = opts or {}
+    local c = setmetatable({}, CHIP)
+    c.mode = { [0] = true, [3] = true }
+    c.link = opts.link ~= false
+    c.segment = opts.segment
+    c.tx_frames, c.rx_frames, c.dropped = 0, 0, 0
+    c:reset()
+    if opts.reset then
+        c.reset_pin = opts.reset
+        gpio.on_change(opts.reset, function(level)
+            c.in_reset = not level
+            if not level then
+                c:reset()
+            end
+        end)
+    end
+    return c
+end
+
+function CHIP:reset()
+    self.common = {}
+    for i = 0, 0x39 do
+        self.common[i] = 0
+    end
+    self.common[0x2E] = 0xB8 -- PHYCFGR: RST = 1, OPMD = 0, OPMDC = 111
+    self.common[0x39] = 0x04
+    self.sock = {}
+    for s = 0, 7 do
+        local r = {}
+        for i = 0, 0x2F do
+            r[i] = 0
+        end
+        r[0x1E], r[0x1F] = 2, 2 -- 2 KiB RX/TX buffers
+        r[0x20], r[0x21] = 0x08, 0x00 -- TX_FSR = 2048
+        self.sock[s] = r
+    end
+    self.tx = {}
+    self.rx = {}
+    self.rx_rd_commit = 0
+    self.open = false
+end
+
+function CHIP:set_link(on)
+    self.link = on
+end
+
+function CHIP:stats()
+    return self.tx_frames, self.rx_frames, self.dropped
+end
+
+-- socket registers ------------------------------------------------------------
+local function get16(r, a)
+    return (r[a] << 8) | r[a + 1]
+end
+
+local function set16(r, a, v)
+    r[a] = (v >> 8) & 0xFF
+    r[a + 1] = v & 0xFF
+end
+
+function CHIP:buf_size(dir)
+    local kb = self.sock[0][dir == "rx" and 0x1E or 0x1F]
+    return kb * 1024
+end
+
+function CHIP:update_sizes()
+    local r = self.sock[0]
+    local txsize, rxsize = self:buf_size("tx"), self:buf_size("rx")
+    set16(r, 0x20, txsize - ((get16(r, 0x24) - get16(r, 0x22)) & 0xFFFF)) -- TX_FSR
+    set16(r, 0x26, (get16(r, 0x2A) - self.rx_rd_commit) & 0xFFFF) -- RX_RSR
+    if txsize == 0 then
+        set16(r, 0x20, 0)
+    end
+    if rxsize == 0 then
+        set16(r, 0x26, 0)
+    end
+end
+
+function CHIP:phycfgr()
+    local v = self.common[0x2E] & 0xF8
+    local opmdc = (v >> 3) & 7
+    local spd, dpx = 1, 1
+    if v & 0x40 ~= 0 and opmdc < 4 then -- forced mode
+        spd, dpx = (opmdc >> 1) & 1, opmdc & 1
+    elseif v & 0x40 ~= 0 and opmdc == 4 then
+        spd, dpx = 1, 0
+    end
+    if not self.link then
+        return v
+    end
+    return v | (dpx << 2) | (spd << 1) | 1
+end
+
+function CHIP:command(cmd)
+    local r = self.sock[0]
+    if cmd == 0x01 then -- OPEN
+        if r[0x00] & 0x0F == 0x04 then
+            r[0x03] = 0x42 -- SOCK_MACRAW
+            self.open = true
+            set16(r, 0x22, 0)
+            set16(r, 0x24, 0)
+            set16(r, 0x28, 0)
+            set16(r, 0x2A, 0)
+            self.rx_rd_commit = 0
+        end
+    elseif cmd == 0x10 then -- CLOSE
+        r[0x03] = 0x00
+        self.open = false
+    elseif cmd == 0x20 and self.open then -- SEND
+        local size = self:buf_size("tx")
+        local rd, wr = get16(r, 0x22), get16(r, 0x24)
+        local n = (wr - rd) & 0xFFFF
+        local t = {}
+        for i = 0, n - 1 do
+            t[#t + 1] = string.char(self.tx[(rd + i) % size] or 0)
+        end
+        local frame = table.concat(t)
+        if #frame >= 14 and #frame <= 1514 and self.link then
+            eth.send(frame, self)
+            self.tx_frames = self.tx_frames + 1
+        end
+        set16(r, 0x22, wr)
+        r[0x02] = r[0x02] | 0x10 -- SEND_OK
+    elseif cmd == 0x40 and self.open then -- RECV
+        self.rx_rd_commit = get16(r, 0x28)
+    end
+    r[0x01] = 0
+    self:update_sizes()
+end
+
+-- Ethernet ---------------------------------------------------------------------
+function CHIP:receive(frame)
+    if not self.open or self.in_reset or not self.link then
+        return
+    end
+    local r = self.sock[0]
+    local dst = frame:sub(1, 6)
+    local mac = string.char(table.unpack(self.common, 0x09, 0x0E))
+    local bcast = dst == "\xFF\xFF\xFF\xFF\xFF\xFF"
+    local mcast = dst:byte(1) & 1 == 1
+    if r[0x00] & 0x80 ~= 0 then -- MFEN
+        if not (dst == mac or bcast or (mcast and r[0x00] & 0x20 == 0)) then
+            return
+        end
+    end
+    if bcast and r[0x00] & 0x40 ~= 0 then -- BCASTB
+        return
+    end
+    self:update_sizes()
+    local size = self:buf_size("rx")
+    local used = get16(r, 0x26)
+    local len = #frame + 2
+    if used + len > size then
+        self.dropped = self.dropped + 1
+        return
+    end
+    local wr = get16(r, 0x2A)
+    local data = string.char(len >> 8, len & 0xFF) .. frame
+    for i = 1, #data do
+        self.rx[(wr + i - 1) % size] = data:byte(i)
+    end
+    set16(r, 0x2A, (wr + len) & 0xFFFF)
+    r[0x02] = r[0x02] | 0x04 -- RECV
+    self.rx_frames = self.rx_frames + 1
+    self:update_sizes()
+end
+
+-- SPI interface ----------------------------------------------------------------
+function CHIP:select()
+    self.hdr = {}
+end
+
+function CHIP:access(byte)
+    local blk, write, addr = self.blk, self.write, self.addr
+    local v = 0
+    if blk == 0 then
+        if write then
+            if addr == 0x00 and byte & 0x80 ~= 0 then
+                self:reset()
+                return 0
+            end
+            if addr <= 0x38 then
+                self.common[addr] = byte
+            end
+        elseif addr == 0x2E then
+            v = self:phycfgr()
+        else
+            v = self.common[addr] or 0
+        end
+    else
+        local s = (blk - 1) // 4
+        local kind = (blk - 1) % 4
+        if kind == 0 then
+            local r = self.sock[s]
+            if write then
+                if addr == 0x02 then
+                    r[0x02] = r[0x02] & ~byte -- Sn_IR: write 1 clears
+                elseif addr <= 0x2F then
+                    r[addr] = byte
+                    if s == 0 and addr == 0x01 then
+                        self:command(byte)
+                    elseif s == 0 then
+                        self:update_sizes()
+                    end
+                end
+            else
+                v = r[addr] or 0
+            end
+        elseif s == 0 and kind == 1 then
+            local size = self:buf_size("tx")
+            if write and size > 0 then
+                self.tx[addr % size] = byte
+            end
+        elseif s == 0 and kind == 2 then
+            local size = self:buf_size("rx")
+            if not write and size > 0 then
+                v = self.rx[addr % size] or 0
+            end
+        end
+    end
+    self.addr = (addr + 1) & 0xFFFF
+    return v
+end
+
+function CHIP:transfer(byte)
+    if self.in_reset then
+        return 0xFF
+    end
+    local hdr = self.hdr
+    if #hdr < 3 then
+        hdr[#hdr + 1] = byte
+        if #hdr == 3 then
+            self.addr = (hdr[1] << 8) | hdr[2]
+            self.blk = hdr[3] >> 3
+            self.write = hdr[3] & 0x04 ~= 0
+        end
+        return 0
+    end
+    return self:access(byte)
+end
+
+function CHIP:deselect()
+    self.hdr = nil
+end
+
+function CHIP:attach(bus, cs)
+    spi.attach(bus, cs, self)
+    eth.attach(self, self.segment)
+    return self
+end
+
+return M
diff --git a/sim-env/tests/adc.lua b/sim-env/tests/adc.lua
new file mode 100644
index 0000000..7ddde3b
--- /dev/null
+++ b/sim-env/tests/adc.lua
@@ -0,0 +1,165 @@
+--[[----------------------------------------------------------------------------
+  ADC driver test executed in dnx RTOS (lua program) with board
+  boards/test.lua: voltages of channels of ADC:0 and ADC:1 are set by the
+  board (control device I2C:0 0x30). Converter is used by read of the device
+  file (position / 2 is a channel) and by luadnx module dnx.adc (ioctl).
+------------------------------------------------------------------------------]]
+
+local T = require("testlib")
+local adc = require("dnx.adc")
+local test, expect = T.test, T.expect
+
+local A0, A1 = "/dev/adc0", "/dev/adc1"
+
+local ctl
+
+local function open(path, mode)
+    local f = assert(io.open(path, mode or "r+b"))
+    f:setvbuf("no")
+    return f
+end
+
+local function control(cmd)
+    ctl:seek("set", 0)
+    assert(ctl:write(cmd))
+    ctl:seek("set", 0)
+    local r = assert(ctl:read(128)):match("^[^%z]*")
+    expect(r == "ok", "control '" .. cmd .. "': " .. r)
+end
+
+local function check(...)
+    local r, msg = ...
+    if r == nil then
+        error(msg, 2)
+    end
+    return ...
+end
+
+local function configure(path, cfg)
+    return T.run(string.format("modprobe -c %s %s", path, cfg))
+end
+
+-- samples of channels by read of file
+local function samples(path, first, n)
+    local f = open(path, "rb")
+    f:seek("set", first * 2)
+    local data = f:read(n * 2)
+    f:close()
+    if not data then
+        return nil
+    end
+    local t = {}
+    for i = 1, #data // 2 do
+        t[i] = string.unpack("<I2", data, i * 2 - 1)
+    end
+    return t
+end
+
+local function raw(path, ch)
+    return (check(adc.read(path, ch)))
+end
+
+-- tests ------------------------------------------------------------------------------
+test("Create devices (modprobe -c), not existing converter", function()
+    T.modprobe("I2C", 0, 22, "/dev/i2c-ow-ctl", "address=0x30")
+    ctl = open("/dev/i2c-ow-ctl")
+    control("adc 0 init")
+    T.modprobe("ADC", 0, 0, A0)
+    T.modprobe("ADC", 1, 0, A1, "resolution=10")
+    expect(not T.run("modprobe -i ADC 4 0 /dev/adc4"), "converter 4 created")
+end)
+
+test("Information: resolution, channels, internal channels, sample time", function()
+    local i = check(adc.info(A0))
+    expect(i.resolution_max == 12 and i.resolution == 12, "resolution " .. i.resolution)
+    expect(i.channels == 16 and i.temp and i.vrefint, "channels")
+    expect(i.vref_mv == 3300 and i.oversampling == 1 and not i.hw_oversampling, "defaults")
+    expect(i.sample_time_ns == 13333, "sample time " .. i.sample_time_ns)
+    expect(check(adc.info(A1)).resolution == 10, "resolution of ADC 1")
+end)
+
+test("Read of file: one channel, channels 0..3", function()
+    expect(samples(A0, 1, 1)[1] == 2048, "channel 1")
+    local s = samples(A0, 0, 4)
+    expect(#s == 4 and s[1] == 0 and s[2] == 2048 and s[3] == 4095 and s[4] == 1241,
+        "channels: " .. table.concat(s, " "))
+    expect(samples(A1, 0, 1)[1] == 155, "ADC 1 channel 0 (10 bits)")
+end)
+
+test("Read beyond the last channel, odd position", function()
+    expect(samples(A0, 16, 1) == nil, "channel 16 read")
+    local s = samples(A0, 14, 4)
+    expect(#s == 2, "read across the last channel: " .. #s)
+    local f = open(A0, "rb")
+    f:seek("set", 3)
+    expect(f:read(2) == nil, "read at odd position")
+    f:close()
+end)
+
+test("ioctl: raw value and voltage", function()
+    local r, v = check(adc.read(A0, 3))
+    expect(r == 1241, "raw " .. r)
+    expect(math.abs(v - 1.0) < 0.001, "voltage " .. v)
+    expect(adc.read(A0, 16) == nil, "channel 16 read")
+end)
+
+test("Resolution 8 and 6 bits, invalid resolution", function()
+    assert(configure(A0, "resolution=8"))
+    expect(raw(A0, 1) == 128 and raw(A0, 2) == 255, "8 bits")
+    assert(configure(A0, "resolution=6"))
+    expect(raw(A0, 2) == 63, "6 bits")
+    expect(not configure(A0, "resolution=7"), "7 bits accepted")
+    expect(not configure(A0, "resolution=14"), "14 bits accepted")
+    assert(configure(A0, "resolution=0"))
+    expect(check(adc.info(A0)).resolution == 12, "maximal resolution")
+end)
+
+test("Oversampling (software), invalid values", function()
+    assert(configure(A0, "oversampling=16"))
+    local i = check(adc.info(A0))
+    expect(i.oversampling == 16 and not i.hw_oversampling, "oversampling")
+    expect(raw(A0, 1) == 2048, "averaged value")
+    expect(not configure(A0, "oversampling=3"), "oversampling 3 accepted")
+    expect(not configure(A0, "oversampling=2048"), "oversampling 2048 accepted")
+    expect(not configure(A0, "oversampling=0"), "oversampling 0 accepted")
+    assert(configure(A0, "oversampling=1"))
+end)
+
+test("Sample time selection", function()
+    assert(configure(A0, "sample_time_ns=0"))
+    expect(check(adc.info(A0)).sample_time_ns == 83, "shortest")
+    assert(configure(A0, "sample_time_ns=100"))
+    expect(check(adc.info(A0)).sample_time_ns == 416, "100 ns")
+    assert(configure(A0, "sample_time_ns=1000"))
+    expect(check(adc.info(A0)).sample_time_ns == 1555, "1000 ns")
+    assert(configure(A0, "sample_time_ns=1000000"))
+    expect(check(adc.info(A0)).sample_time_ns == 13333, "longest")
+end)
+
+test("Reference voltage of calculation", function()
+    assert(configure(A0, "vref_mv=3000"))
+    local _, v = check(adc.read(A0, 1))
+    assert(configure(A0, "vref_mv=3300"))
+    expect(math.abs(v - 1.5) < 0.001, "voltage " .. v)
+    expect(not configure(A0, "vref_mv=0"), "vref 0 accepted")
+end)
+
+test("Voltage changed by board", function()
+    control("adc 0 5 2.5")
+    expect(raw(A0, 5) == 3102, "channel 5: " .. raw(A0, 5))
+    control("adc 0 5 4.0")
+    expect(raw(A0, 5) == 4095, "saturation")
+end)
+
+test("Internal channels: temperature, reference", function()
+    local t = check(adc.temperature(A0))
+    expect(math.abs(t - 25) < 0.5, "temperature " .. t)
+    control("adc 0 temp 60")
+    t = check(adc.temperature(A0))
+    expect(math.abs(t - 60) < 0.5, "temperature " .. t)
+    control("adc 0 temp 25")
+    local _, v = check(adc.read(A0, "vref"))
+    expect(math.abs(v - 1.21) < 0.002, "reference " .. v)
+end)
+
+T.summary()
diff --git a/sim-env/tests/inet2.lua b/sim-env/tests/inet2.lua
new file mode 100644
index 0000000..2c04267
--- /dev/null
+++ b/sim-env/tests/inet2.lua
@@ -0,0 +1,139 @@
+--[[----------------------------------------------------------------------------
+  Second network interface of the TCP/IP stack (lwIP) executed in dnx RTOS
+  (lua program) with board boards/test.lua: network "inet" (/dev/eth,
+  192.168.77.0/24) and network "inet1" (W5500 on SPI:0, segment "lan2"
+  192.168.78.0/24), both configured by netmgr (app-romfs/netmgr.conf: inet1
+  is configured when the test creates /dev/eth-w5500). Both networks are used
+  at the same time: ping from devices of both segments, TCP echo by nc,
+  routing of socket opened on other network than destination, link of W5500
+  disconnected and connected again (netmgr).
+------------------------------------------------------------------------------]]
+
+local T = require("testlib")
+local eth = require("dnx.eth")
+local test, expect = T.test, T.expect
+
+local W5500 = "/dev/eth-w5500"
+local NET2 = "inet1"
+
+local function run(cmd)
+    local ok, out = T.run(cmd)
+    if not ok then
+        error(cmd .. ": " .. tostring(out), 2)
+    end
+    return out
+end
+
+local ctl
+local networks -- number of networks before test
+
+local function count_networks()
+    return tonumber(run("ifconfig"):match("Number of networks: (%d+)"))
+end
+
+-- wait for state of network (ifconfig output contains text, or not)
+local function wait_network(netname, text, present, timeout)
+    for _ = 1, (timeout or 10000) // 250 do
+        local ok, out = T.run("ifconfig " .. netname)
+        if ((ok and out:find(text, 1, true)) ~= nil) == present then
+            return true
+        end
+        T.msleep(250)
+    end
+    return false
+end
+
+local function open(path)
+    local f = assert(io.open(path, "r+b"))
+    f:setvbuf("no")
+    return f
+end
+
+local function control(cmd)
+    ctl:seek("set", 0)
+    assert(ctl:write(cmd))
+    ctl:seek("set", 0)
+    return assert(ctl:read(128)):match("^[^%z]*")
+end
+
+-- ping from model: cmd "net" (192.168.77.50) or "net2" (192.168.78.50)
+local function model_ping(cmd, ip)
+    control(cmd .. " ping " .. ip)
+    for _ = 1, 40 do
+        local r = control(cmd .. " pingres")
+        if r ~= "pending" then
+            return r
+        end
+        T.msleep(50)
+    end
+    return "timeout"
+end
+
+local function tcp_echo(text, ip, netname)
+    local cmd = string.format("nc -w 5 -h -s %s %s%s 7", text, netname and ("-n " .. netname .. " ") or "", ip)
+    local ok, out = T.run(cmd)
+    return ok and out:find(text, 1, true) ~= nil, out
+end
+
+-- tests ------------------------------------------------------------------------------
+test("Network inet1 configured by netmgr when interface file is created", function()
+    T.spi_devices()
+    T.modprobe("I2C", 0, 22, "/dev/i2c-ow-ctl", "address=0x30")
+    ctl = open("/dev/i2c-ow-ctl")
+    networks = count_networks()
+    T.modprobe("W5500", 2, 0, W5500, "spi_path=/dev/spi-w5500,reset_port=1,reset_pin=10")
+    expect(wait_network(NET2, "192.168.78.2", true), "inet1 not configured by netmgr")
+    expect(count_networks() == networks + 1, "number of networks")
+    expect(run("ifconfig inet"):find("192.168.77.2", 1, true), "address of inet")
+end)
+
+test("Ping of the system from devices of both segments", function()
+    local r2 = model_ping("net2", "192.168.78.2")
+    local r1 = model_ping("net", "192.168.77.2")
+    expect(r2:find("^ok"), "inet1: " .. r2)
+    expect(r1:find("^ok"), "inet: " .. r1)
+end)
+
+test("TCP echo through both interfaces", function()
+    local ok2, out2 = tcp_echo("via-w5500", "192.168.78.50")
+    local ok1, out1 = tcp_echo("via-eth", "192.168.77.50")
+    expect(ok2, "inet1: " .. out2)
+    expect(ok1, "inet: " .. out1)
+end)
+
+test("Socket of network inet1, destination in network inet (routing by address)", function()
+    local ok, out = tcp_echo("cross-route", "192.168.77.50", NET2)
+    expect(ok, out)
+end)
+
+test("Statistics of W5500 interface", function()
+    local st = assert(eth.status(W5500))
+    expect(st.tx_packets > 0 and st.rx_packets > 0, "packets " .. st.tx_packets .. " " .. st.rx_packets)
+end)
+
+test("Link of W5500 disconnected: inet1 down (netmgr), inet works", function()
+    control("w5500 link 0")
+    local down = wait_network(NET2, "192.168.78.2", false)
+    local r1 = model_ping("net", "192.168.77.2")
+    expect(down, "inet1 not disabled after link loss")
+    expect(r1:find("^ok"), "inet: " .. r1)
+end)
+
+test("Link connected: inet1 configured again (netmgr)", function()
+    control("w5500 link 1")
+    expect(wait_network(NET2, "192.168.78.2", true), "inet1 not configured after link")
+    local r2 = model_ping("net2", "192.168.78.2")
+    expect(r2:find("^ok"), "inet1: " .. r2)
+end)
+
+test("ifconfig: invalid family of added network", function()
+    expect(not T.run("ifconfig inet9 add=xyz:/dev/eth"), "invalid family accepted")
+    expect(not T.run("ifconfig " .. NET2 .. " add=inet:" .. W5500), "network added twice")
+end)
+
+test("Link disconnected at the end (W5500 does not load SPI:0 in next tests)", function()
+    control("w5500 link 0")
+    expect(wait_network(NET2, "192.168.78.2", false), "inet1 not disabled")
+end)
+
+T.summary()
diff --git a/sim-env/tests/norflash.lua b/sim-env/tests/norflash.lua
new file mode 100644
index 0000000..2d7d09a
--- /dev/null
+++ b/sim-env/tests/norflash.lua
@@ -0,0 +1,228 @@
+--[[----------------------------------------------------------------------------
+  NORFLASH driver test executed in dnx RTOS (lua program) with board
+  boards/test.lua: NOR flash memories on SPI:0, W25Q16 (CS PB3, SFDP),
+  MX25L8005 (CS PB4, no SFDP, deep power-down at start), W25Q256 (CS PB5,
+  4-byte address), SST26VF016 (CS PB6, protected at power-up), no memory on
+  CS PB7. Sector erases and page programs are counted by the board (control
+  device I2C:0 0x30).
+------------------------------------------------------------------------------]]
+
+local T = require("testlib")
+local lfs = require("lfs")
+local test, expect = T.test, T.expect
+
+local F0, F1, F2, F3 = "/dev/flash0", "/dev/flash1", "/dev/flash2", "/dev/flash3"
+local MNT = "/mnt/norflash"
+local SECTOR = 4096
+local MiB = 1024 * 1024
+
+local ctl
+
+local function run(cmd)
+    local ok, out = T.run(cmd)
+    if not ok then
+        error(cmd .. ": " .. tostring(out), 2)
+    end
+    return out
+end
+
+local function open(path)
+    local f = assert(io.open(path, "r+b"))
+    f:setvbuf("no")
+    return f
+end
+
+local function control(cmd)
+    ctl:seek("set", 0)
+    assert(ctl:write(cmd))
+    ctl:seek("set", 0)
+    return assert(ctl:read(128)):match("^[^%z]*")
+end
+
+-- sector erases and page programs of chip (CS PB<n>)
+local function stats(n)
+    local e, p = control("nor " .. n .. " stats"):match("^(%d+) (%d+)")
+    return tonumber(e), tonumber(p)
+end
+
+local function pattern(n, seed)
+    local t, x = {}, seed
+    for i = 1, n do
+        x = (x * 1103515245 + 12345) & 0x7FFFFFFF
+        t[i] = string.char((x >> 16) & 0xFF)
+    end
+    return table.concat(t)
+end
+
+local function dev_write(path, pos, data)
+    local f = open(path)
+    f:seek("set", pos)
+    local ok, err = f:write(data)
+    f:close()
+    return ok, err
+end
+
+local function dev_read(path, pos, n)
+    local f = open(path)
+    f:seek("set", pos)
+    local data = f:read(n)
+    f:close()
+    return data
+end
+
+local function write_file(path, data)
+    local f = assert(io.open(path, "wb"))
+    assert(f:write(data))
+    f:close()
+end
+
+local function read_file(path)
+    local f = io.open(path, "rb")
+    if not f then
+        return nil
+    end
+    local data = f:read("a")
+    f:close()
+    return data
+end
+
+-- tests ------------------------------------------------------------------------------
+test("Create devices (modprobe -c), identification", function()
+    T.spi_devices()
+    T.modprobe("I2C", 0, 22, "/dev/i2c-ow-ctl", "address=0x30")
+    ctl = open("/dev/i2c-ow-ctl")
+    T.modprobe("NORFLASH", 0, 0, F0, "path=/dev/spi-nor-a")
+    T.modprobe("NORFLASH", 1, 0, F1, "path=/dev/spi-nor-b")
+    T.modprobe("NORFLASH", 2, 0, F2, "path=/dev/spi-nor-c")
+    T.modprobe("NORFLASH", 3, 0, F3, "path=/dev/spi-nor-d")
+end)
+
+test("Detected size (SFDP, JEDEC ID, deep power-down)", function()
+    local SIZES = { [F0] = 2 * MiB, [F1] = 1 * MiB, [F2] = 32 * MiB, [F3] = 2 * MiB }
+    for path, size in pairs(SIZES) do
+        local a = assert(lfs.attributes(path))
+        expect(a.size == size, path .. ": size " .. tostring(a.size))
+    end
+end)
+
+test("No memory: configuration fails, device without memory", function()
+    T.modprobe("NORFLASH", 4, 0, "/dev/flash4")
+    local ok = T.run("modprobe -c /dev/flash4 path=/dev/spi-nor-none")
+    expect(not ok, "configuration without memory succeeded")
+    ok = T.run("modprobe -c /dev/flash4 path=/dev/spi-nor-a,interface=usb")
+    expect(not ok, "invalid interface accepted")
+    expect(io.open("/dev/flash4", "rb"):read(16) == nil, "read of not configured device")
+end)
+
+test("Erased memory reads 0xFF", function()
+    expect(dev_read(F0, 0, SECTOR) == string.rep("\xFF", SECTOR), "not erased")
+end)
+
+test("Write erased sector: program without erase", function()
+    local e0, p0 = stats(3)
+    local data = pattern(SECTOR, 1)
+    assert(dev_write(F0, 2 * SECTOR, data))
+    local e1, p1 = stats(3)
+    expect(dev_read(F0, 2 * SECTOR, SECTOR) == data, "data mismatch")
+    expect(e1 == e0, "sector erased: " .. (e1 - e0))
+    expect(p1 - p0 == 16, "page programs: " .. (p1 - p0))
+end)
+
+test("Write the same data: nothing programmed", function()
+    local e0, p0 = stats(3)
+    assert(dev_write(F0, 2 * SECTOR, pattern(SECTOR, 1)))
+    local e1, p1 = stats(3)
+    expect(e1 == e0 and p1 == p0, string.format("erases %d, programs %d", e1 - e0, p1 - p0))
+end)
+
+test("Overwrite: sector erase, pages with 0xFF are not programmed", function()
+    local e0, p0 = stats(3)
+    local data = pattern(SECTOR, 2):sub(1, 1000) .. string.rep("\xFF", SECTOR - 1000)
+    assert(dev_write(F0, 2 * SECTOR, data))
+    local e1, p1 = stats(3)
+    expect(dev_read(F0, 2 * SECTOR, SECTOR) == data, "data mismatch")
+    expect(e1 - e0 == 1, "sector erases: " .. (e1 - e0))
+    expect(p1 - p0 == 4, "page programs: " .. (p1 - p0))
+end)
+
+test("Clear bits only: programmed without erase", function()
+    local old = dev_read(F0, 2 * SECTOR, SECTOR)
+    local t = {}
+    for i = 1, SECTOR do
+        t[i] = string.char(old:byte(i) & 0x5A)
+    end
+    local data = table.concat(t)
+    local e0 = stats(3)
+    assert(dev_write(F0, 2 * SECTOR, data))
+    expect(stats(3) == e0, "sector erased")
+    expect(dev_read(F0, 2 * SECTOR, SECTOR) == data, "data mismatch")
+end)
+
+test("Unaligned write across sectors (read-modify-write)", function()
+    local base = 8 * SECTOR
+    local before = pattern(3 * SECTOR, 3)
+    assert(dev_write(F0, base, before))
+    local data = pattern(5000, 4)
+    assert(dev_write(F0, base + 1234, data))
+    local exp = before:sub(1, 1234) .. data .. before:sub(1234 + #data + 1)
+    expect(dev_read(F0, base, 3 * SECTOR) == exp, "data mismatch")
+end)
+
+test("Write and read at the end of memory, beyond the end", function()
+    local data = pattern(SECTOR, 5)
+    assert(dev_write(F1, MiB - SECTOR, data))
+    expect(dev_read(F1, MiB - SECTOR, SECTOR) == data, "data mismatch")
+    expect(dev_read(F1, MiB, 16) == nil, "read beyond the end")
+end)
+
+test("4-byte address (32 MiB memory)", function()
+    local data = pattern(SECTOR, 6)
+    assert(dev_write(F2, 20 * MiB, data))
+    expect(dev_read(F2, 20 * MiB, SECTOR) == data, "data mismatch")
+    expect(dev_read(F2, 4 * MiB, SECTOR) == string.rep("\xFF", SECTOR), "address wrapped at 16 MiB")
+end)
+
+test("Protected memory: write error, unprotect", function()
+    local ok = dev_write(F3, 0, pattern(SECTOR, 7))
+    expect(not ok, "write of protected memory succeeded")
+    run("modprobe -c " .. F3 .. " path=/dev/spi-nor-d,unprotect=1")
+    local data = pattern(SECTOR, 7)
+    assert(dev_write(F3, 0, data))
+    expect(dev_read(F3, 0, SECTOR) == data, "data mismatch")
+end)
+
+test("Configured size", function()
+    run("modprobe -c " .. F1 .. " path=/dev/spi-nor-b,size=524288")
+    expect(lfs.attributes(F1).size == 524288, "size not changed")
+    expect(not T.run("modprobe -c " .. F1 .. " path=/dev/spi-nor-b,size=1000"), "invalid size accepted")
+    run("modprobe -c " .. F1 .. " path=/dev/spi-nor-b")
+    expect(lfs.attributes(F1).size == MiB, "size not detected")
+end)
+
+local FILES = {
+    { MNT .. "/small.txt", "Hello from NOR flash!\n" },
+    { MNT .. "/big.bin", pattern(20000, 8) },
+    { MNT .. "/dir/nested.bin", pattern(777, 9) },
+}
+
+test("flatfs: format, write files, remount, read", function()
+    run("mkflatfs " .. F0 .. " 64")
+    run("mkdir " .. MNT)
+    run("mount " .. F0 .. " flatfs " .. MNT)
+    run("mkdir " .. MNT .. "/dir")
+    for _, f in ipairs(FILES) do
+        write_file(f[1], f[2])
+    end
+    run("umount " .. MNT)
+    run("mount " .. F0 .. " flatfs " .. MNT)
+    for _, f in ipairs(FILES) do
+        expect(read_file(f[1]) == f[2], f[1] .. ": data mismatch")
+    end
+    for i = #FILES, 1, -1 do
+        expect(os.remove(FILES[i][1]), "remove " .. FILES[i][1])
+    end
+    expect(os.remove(MNT .. "/dir"), "remove dir")
+    run("umount " .. MNT)
+end)
+
+T.summary()
diff --git a/sim-env/tests/onewire.lua b/sim-env/tests/onewire.lua
new file mode 100644
index 0000000..a4a0c75
--- /dev/null
+++ b/sim-env/tests/onewire.lua
@@ -0,0 +1,175 @@
+--[[----------------------------------------------------------------------------
+  ONEWIRE driver test executed in dnx RTOS (lua program) with board
+  boards/test.lua: 1-Wire master on UART:6 (/dev/ttyS6) with DS18B20 sensors
+  1..3 (3: parasite power), strong pull-up pin PB8. Bus is used by luadnx
+  module dnx.onewire (ioctl) and by read/write of the device file. Sensors
+  are controlled by the test control device (I2C:0 0x30).
+------------------------------------------------------------------------------]]
+
+local T = require("testlib")
+local ow = require("dnx.onewire")
+local test, expect = T.test, T.expect
+
+local DEV = "/dev/ow0"
+
+local ctl
+
+local function open(path)
+    local f = assert(io.open(path, "r+b"))
+    f:setvbuf("no")
+    return f
+end
+
+local function control(cmd)
+    ctl:seek("set", 0)
+    assert(ctl:write(cmd))
+    ctl:seek("set", 0)
+    local r = assert(ctl:read(128)):match("^[^%z]*")
+    expect(r == "ok", "control '" .. cmd .. "': " .. r)
+end
+
+local function crc8(s)
+    local crc = 0
+    for i = 1, #s do
+        crc = crc ~ s:byte(i)
+        for _ = 1, 8 do
+            crc = (crc & 1 == 1) and ((crc >> 1) ~ 0x8C) or (crc >> 1)
+        end
+    end
+    return crc
+end
+
+-- ROM code (hex, bus order) of DS18B20 with serial number
+local function rom_of(serial)
+    local b = string.char(0x28) .. string.pack("<I6", serial)
+    b = b .. string.char(crc8(b))
+    return (b:gsub(".", function(c)
+        return string.format("%02X", c:byte())
+    end))
+end
+
+local ROMS = { rom_of(0x0000000A0001), rom_of(0x8000000A0002), rom_of(0x0000000A0003) }
+
+local function sorted(t)
+    local c = { table.unpack(t) }
+    table.sort(c)
+    return table.concat(c, ",")
+end
+
+local function check(...)
+    local r, msg = ...
+    if r == nil then
+        error(msg, 2)
+    end
+    return ...
+end
+
+-- temperature of sensor (scratchpad read by MATCH ROM), TH, TL
+local function temperature(rom)
+    local sp = check(ow.transfer(DEV, rom, "\xBE", 9))
+    expect(crc8(sp:sub(1, 8)) == sp:byte(9), "scratchpad CRC error")
+    local raw = string.unpack("<i2", sp)
+    return raw / 16, string.unpack("i1", sp, 3), string.unpack("i1", sp, 4)
+end
+
+local function convert(spu_ms)
+    check(ow.transfer(DEV, nil, "\x44", 0, spu_ms))
+    if spu_ms == 0 then
+        T.msleep(800)
+    end
+end
+
+-- tests ------------------------------------------------------------------------------
+test("Create device (modprobe -c), invalid configuration", function()
+    T.modprobe("I2C", 0, 22, "/dev/i2c-ow-ctl", "address=0x30")
+    ctl = open("/dev/i2c-ow-ctl")
+    T.modprobe("ONEWIRE", 1, 0, "/dev/ow1")
+    expect(not T.run("modprobe -c /dev/ow1 spu_pin=8"), "configuration without path accepted")
+    expect(ow.reset("/dev/ow1") == nil, "reset of not configured bus")
+    T.modprobe("ONEWIRE", 0, 0, DEV, "path=/dev/ttyS6,spu_port=1,spu_pin=8")
+end)
+
+test("Reset: presence pulse", function()
+    expect(check(ow.reset(DEV)) == true, "no presence")
+end)
+
+test("SEARCH ROM: all sensors with valid ROM codes", function()
+    local roms = check(ow.search(DEV))
+    expect(sorted(roms) == sorted(ROMS), "found: " .. sorted(roms))
+end)
+
+test("Conversion with strong pull-up, scratchpad of each sensor", function()
+    convert(750)
+    local EXP = { 23.5, -5.25, 60.125 }
+    for i, rom in ipairs(ROMS) do
+        local t = temperature(rom)
+        expect(t == EXP[i], "sensor " .. i .. ": " .. t)
+    end
+end)
+
+test("Parasite sensor without strong pull-up: conversion fails", function()
+    control("owu temp 1 30.5")
+    control("owu temp 3 10")
+    convert(0)
+    expect(temperature(ROMS[1]) == 30.5, "sensor 1 not converted")
+    expect(temperature(ROMS[3]) == 60.125, "parasite sensor converted without strong pull-up")
+    convert(750)
+    expect(temperature(ROMS[3]) == 10, "parasite sensor not converted")
+end)
+
+test("ALARM SEARCH (TH, TL written by SKIP ROM)", function()
+    check(ow.transfer(DEV, nil, "\x4E\x32\xF6\x7F")) -- TH 50, TL -10, 12 bits
+    local _, th, tl = temperature(ROMS[2])
+    expect(th == 50 and tl == -10, "TH/TL not written: " .. th .. " " .. tl)
+    control("owu temp 3 70")
+    convert(750)
+    local roms = check(ow.search(DEV, true))
+    expect(sorted(roms) == ROMS[3], "alarm: " .. sorted(roms))
+end)
+
+test("Device file: read and write of bytes (MATCH ROM, READ SCRATCHPAD)", function()
+    expect(check(ow.reset(DEV)), "no presence")
+    local f = open(DEV)
+    local rom = ROMS[1]:gsub("%x%x", function(h)
+        return string.char(tonumber(h, 16))
+    end)
+    assert(f:write("\x55" .. rom .. "\xBE"))
+    local sp = assert(f:read(9))
+    f:close()
+    expect(crc8(sp:sub(1, 8)) == sp:byte(9), "scratchpad CRC error")
+    expect(string.unpack("<i2", sp) / 16 == 30.5, "temperature")
+end)
+
+test("Hot-plug: detached sensor is not found", function()
+    control("owu detach 2")
+    local roms = check(ow.search(DEV))
+    control("owu attach 2")
+    expect(sorted(roms) == sorted({ ROMS[1], ROMS[3] }), "found: " .. sorted(roms))
+    expect(#check(ow.search(DEV)) == 3, "attached sensor not found")
+end)
+
+test("No devices: no presence, transfer fails, empty search", function()
+    for i = 1, 3 do
+        control("owu detach " .. i)
+    end
+    local presence = ow.reset(DEV)
+    local r, _, errno = ow.transfer(DEV, nil, "\x44")
+    local roms = ow.search(DEV)
+    for i = 1, 3 do
+        control("owu attach " .. i)
+    end
+    expect(presence == false, "presence without devices")
+    expect(r == nil and errno ~= nil, "transfer without devices")
+    expect(roms and #roms == 0, "search without devices")
+end)
+
+test("Line shorted: bus error", function()
+    control("owu short 1")
+    local r = ow.reset(DEV)
+    local roms = ow.search(DEV)
+    control("owu short 0")
+    expect(r == nil and roms == nil, "error not reported")
+    expect(check(ow.reset(DEV)) == true, "no presence after short")
+end)
+
+T.summary()
