	["config/app-kernel/custom_linker_script.h"]={
		["__ARCH__"]="stm32h7";
		["__MEMORY_10__"]="\"\"";
		["__MEMORY_11__"]="\"\"";
		["__MEMORY_12__"]="\"\"";
		["__MEMORY_13__"]="\"\"";
		["__MEMORY_14__"]="\"\"";
		["__MEMORY_15__"]="\"\"";
		["__MEMORY_16__"]="\"\"";
		["__MEMORY_1__"]="\"flash   (rx)  : org = 0x08000000, len = 512k\"";
		["__MEMORY_2__"]="\"axisram (rwx) : org = 0x24000000, len = 512k\"";
		["__MEMORY_3__"]="\"sram1   (rwx) : org = 0x30000000, len = 128k\"";
		["__MEMORY_4__"]="\"sram2   (rwx) : org = 0x30020000, len = 128k\"";
		["__MEMORY_5__"]="\"sram3   (rwx) : org = 0x30040000, len = 32k\"";
		["__MEMORY_6__"]="\"sram4   (rwx) : org = 0x38000000, len = 64k\"";
		["__MEMORY_7__"]="\"itcm    (rwx) : org = 0x00000000, len = 64k\"";
		["__MEMORY_8__"]="\"dtcm    (rw)  : org = 0x20000000, len = 128k\"";
		["__MEMORY_9__"]="\"bkp     (rw)  : org = 0x38800000, len = 4k\"";
	};
