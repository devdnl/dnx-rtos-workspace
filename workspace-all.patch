-int ext4_flink(const char *path, const char *hardlink_path, struct ext4_mountpoint *mp)
-{
-	int r;
-	ext4_file f;
-	uint32_t name_off;
-	bool child_loaded = false;
-	uint32_t parent_inode, child_inode;
-	struct ext4_mountpoint *target_mp = mp;
