- * @param   on_off
- *              !0 - ENABLE
- *               0 - DISABLE (all delayed cache buffers will be flushed)
- * @return  standard error code*/
-int ext4_block_cache_write_back(struct ext4_blockdev *bdev, uint8_t on_off);
-
-#ifdef __cplusplus
-}
-#endif
-
-#endif /* EXT4_BLOCKDEV_H_ */
-
-/**
- * @}
- */
