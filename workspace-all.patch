- * @param gid  Group id.
- *
- * @return  Standard error code.*/
-int ext4_owner_set(const char *path, uint32_t uid, uint32_t gid, struct ext4_mountpoint *mp);
-
-/**@brief Get file/directory/link owner and group.
- *
- * @param path Path to file/dir/link.
