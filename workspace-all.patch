-	unalg = (off & (bdev->bdif->ph_bsize - 1));
-	if (unalg) {
-
-		uint32_t rlen = (bdev->bdif->ph_bsize - unalg) > len
-				    ? len
-				    : (bdev->bdif->ph_bsize - unalg);
-
-		r = ext4_bdif_bread(bdev, bdev->bdif->ph_bbuf, block_idx, 1);
-		if (r != EOK)
-			return r;
-
-		memcpy(p, bdev->bdif->ph_bbuf + unalg, rlen);
-
-		p += rlen;
-		len -= rlen;
-		block_idx++;
