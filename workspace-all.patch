-int ext4_block_cache_flush(struct ext4_blockdev *bdev)
-{
-	while (!SLIST_EMPTY(&bdev->bc->dirty_list)) {
-		int r;
-		struct ext4_buf *buf = SLIST_FIRST(&bdev->bc->dirty_list);
-		ext4_assert(buf);
-		r = ext4_block_flush_buf(bdev, buf);
-		if (r != EOK)
-			return r;
-
-	}
-	return EOK;
-}
