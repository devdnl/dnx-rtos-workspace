-#define DEBUG_MBR (1ul << 17)
-
-#define DEBUG_NOPREFIX (1ul << 31)
-#define DEBUG_ALL (0xFFFFFFFF)
-
-static inline const char *ext4_dmask_id2str(uint32_t m)
-{
-	switch(m) {
-	case DEBUG_BALLOC:
-		return "ext4_balloc: ";
-	case DEBUG_BCACHE:
-		return "ext4_bcache: ";
-	case DEBUG_BITMAP:
-		return "ext4_bitmap: ";
-	case DEBUG_BLOCK_GROUP:
-		return "ext4_block_group: ";
-	case DEBUG_BLOCKDEV:
-		return "ext4_blockdev: ";
-	case DEBUG_DIR_IDX:
-		return "ext4_dir_idx: ";
-	case DEBUG_DIR:
-		return "ext4_dir: ";
-	case DEBUG_EXTENT:
-		return "ext4_extent: ";
-	case DEBUG_FS:
-		return "ext4_fs: ";
-	case DEBUG_HASH:
-		return "ext4_hash: ";
-	case DEBUG_IALLOC:
-		return "ext4_ialloc: ";
-	case DEBUG_INODE:
-		return "ext4_inode: ";
-	case DEBUG_SUPER:
-		return "ext4_super: ";
-	case DEBUG_XATTR:
-		return "ext4_xattr: ";
-	case DEBUG_MKFS:
-		return "ext4_mkfs: ";
-	case DEBUG_JBD:
-		return "ext4_jbd: ";
-	case DEBUG_MBR:
-		return "ext4_mbr: ";
-	case DEBUG_EXT4:
-		return "ext4: ";
-	}
-	return "";
-}
