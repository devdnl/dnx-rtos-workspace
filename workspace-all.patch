-
-#define ext4_assert(_v) _assert_hook(_v, "EXT4FS")
-#else
-#define ext4_assert(_v) _assert_hook(_v, "EXT4FS")
-#endif
-#else
-#define ext4_assert(_v) ((void)(_v))
-#endif
-
-#ifdef __cplusplus
-}
-#endif
-
-#endif /* EXT4_DEBUG_H_ */
-
-/**
- * @}
- */
